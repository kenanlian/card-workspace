---
import { BASE } from '../content/site';

// Redirect the site root (/card-workspace/) to the default locale.
const target = `${BASE}/en/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${BASE}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${BASE}/apple-touch-icon.png`} />
    <title>Card Workspace</title>
  </head>
  <body>
    <p>Redirecting to <a href={target}>the documentation</a>…</p>
  </body>
</html>
