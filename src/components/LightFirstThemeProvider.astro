{/* Inline and unbundled so the theme is settled before the first paint.
    Starlight's own provider also drives its theme picker; the shared header
    replaces that picker with a toggle, so only the applying half is left. */}
<script is:inline>
  (() => {
    const readPreference = () => {
      const stored =
        typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
      return stored === 'light' || stored === 'dark' ? stored : 'auto';
    };
    const applyTheme = () => {
      const preference = readPreference();
      document.documentElement.dataset.theme =
        preference === 'auto'
          ? window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark'
          : preference;
    };
    applyTheme();
    // The client router copies `<html>` attributes from the incoming document,
    // which would otherwise restore the server-rendered `data-theme="dark"`.
    document.addEventListener('astro:after-swap', applyTheme);
    // Follow the system while no explicit preference is stored.
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', applyTheme);
  })();
</script>
