---
import { getLanding } from '../content/landing';
import type { Locale } from '../content/site';
import cnFlag from '../assets/flags/cn.svg?url';
import usFlag from '../assets/flags/us.svg?url';
import BrandMark from './landing/BrandMark.astro';
import GithubMark from './landing/GithubMark.astro';
import GlobeMark from './landing/GlobeMark.astro';
import MoonMark from './landing/MoonMark.astro';
import SunMark from './landing/SunMark.astro';

interface Props {
  locale: Locale;
  /** Where the brand goes back to: the top of the landing page, or the landing page itself. */
  brandHref: string;
  /** The counterpart of the current page in the other locale. */
  languageHref: string;
  /** Docs pages are already in the docs, so the label reports position instead of linking. */
  inDocs?: boolean;
}

const { locale, brandHref, languageHref, inDocs = false } = Astro.props;
const c = getLanding(locale);

const languages = [
  { locale: 'en', label: 'English', flagSrc: usFlag, hreflang: 'en' },
  { locale: 'zh', label: '简体中文', flagSrc: cnFlag, hreflang: 'zh-CN' },
] as const;
---

<div class="cw-header__inner">
  <a class="cw-brand" href={brandHref} aria-label="Card Workspace">
    <BrandMark />
    <span class="cw-brand__name">Card Workspace</span>
  </a>

  <a class="cw-version" href={c.versionHref} title={c.versionTitle}>
    <span class="cw-version__dot" aria-hidden="true"></span>
    <span>{c.version}</span>
  </a>

  <div class="cw-header__tools">
    <slot name="search" />

    {
      inDocs ? (
        <span class="cw-tool cw-tool--current" aria-current="page">
          {c.docsLabel}
        </span>
      ) : (
        <a class="cw-tool" href={c.docsHref}>
          {c.docsLabel}
        </a>
      )
    }

    <details class="cw-lang">
      <summary class="cw-tool cw-lang__trigger" aria-label={c.languageMenuLabel} title={c.languageMenuLabel}>
        <GlobeMark />
      </summary>
      <nav class="cw-lang__menu" aria-label={c.languageMenuLabel}>
        <ul>
          {
            languages.map((language) => (
              <li>
                {language.locale === locale ? (
                  <span class="cw-lang__option cw-lang__option--current" lang={language.hreflang} aria-current="page">
                    <img class="cw-lang__flag" src={language.flagSrc} alt="" width="20" height="15" aria-hidden="true" />
                    <span>{language.label}</span>
                  </span>
                ) : (
                  <a class="cw-lang__option" href={languageHref} lang={language.hreflang} hreflang={language.hreflang}>
                    <img class="cw-lang__flag" src={language.flagSrc} alt="" width="20" height="15" aria-hidden="true" />
                    <span>{language.label}</span>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <button class="cw-tool cw-theme" type="button" aria-label={c.themeLabel} title={c.themeLabel}>
      <span class="cw-theme__light"><SunMark /></span>
      <span class="cw-theme__dark"><MoonMark /></span>
    </button>

    <a class="cw-tool" href={c.repoHref} aria-label={c.repoLabel} title={c.repoLabel}>
      <GithubMark />
    </a>
  </div>
</div>

<script>
  let headerDocumentListeners: AbortController | undefined;

  // The client router replaces the body on navigation, so bind on every page
  // load rather than once at module evaluation.
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.cw-theme');

    const syncPressedState = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(isDark)));
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('starlight-theme', nextTheme);
        syncPressedState();
      });
    });

    syncPressedState();

    headerDocumentListeners?.abort();
    headerDocumentListeners = new AbortController();

    document.addEventListener(
      'click',
      (event) => {
        document.querySelectorAll<HTMLDetailsElement>('.cw-lang[open]').forEach((menu) => {
          if (!menu.contains(event.target as Node)) menu.open = false;
        });
      },
      { signal: headerDocumentListeners.signal }
    );

    document.querySelectorAll<HTMLDetailsElement>('.cw-lang').forEach((menu) => {
      menu.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !menu.open) return;
        menu.open = false;
        menu.querySelector<HTMLElement>('.cw-lang__trigger')?.focus();
      });
    });
  });
</script>
