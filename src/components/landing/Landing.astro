---
import '../../styles/landing.css';
import { getLanding, type Locale } from '../../content/landing';
import SiteHeader from '../SiteHeader.astro';
import BrandMark from './BrandMark.astro';
import Btn from './Btn.astro';
import MediaClip from './MediaClip.astro';
import SectionRule from './SectionRule.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getLanding(locale);
const headlineLabel = c.hero.headline.join(locale === 'zh' ? '' : ' ');

/* Rendered by `videos/`: `<id>-<locale>.mp4` with its `<id>-<locale>-poster.webp`. */
const clipFiles = import.meta.glob<string>('../../assets/media/clips/*.mp4', { eager: true, import: 'default' });
const posterFiles = import.meta.glob<ImageMetadata>('../../assets/media/clips/*-poster.webp', { eager: true, import: 'default' });
function clip(id: string): { src: string; poster: ImageMetadata } {
  const base = `../../assets/media/clips/${id}-${locale}`;
  const src = clipFiles[`${base}.mp4`];
  const poster = posterFiles[`${base}-poster.webp`];
  if (!src || !poster) throw new Error(`Missing landing clip ${id}-${locale}`);
  return { src, poster };
}
const clips = {
  hero: clip('hero'),
  gather: clip('gather'),
  images: clip('images'),
  links: clip('links'),
  search: clip('search'),
  drag: clip('drag'),
  boxes: clip('boxes'),
  bulk: clip('bulk'),
};
---

<div class="cw-page not-content" data-screen-label="Card Workspace landing">
  <a class="cw-skip" href="#cw-main">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>

  <header class="cw-header">
    <SiteHeader locale={locale} brandHref="#top" languageHref={c.languageHref} />
  </header>

  <div id="cw-main" tabindex="-1">
    <section class="cw-hero" id="top" data-screen-label="Hero">
      <div class="cw-wrap cw-hero__grid">
        <div class="cw-hero__copy">
          <p class="cw-kicker">{c.hero.eyebrow}</p>
          <h1 aria-label={headlineLabel}>
            {
              c.hero.headline.map((line) => (
                <span class="cw-headline__line cw-headline__line--standard" aria-hidden="true">{line}</span>
              ))
            }
            {
              c.hero.headlineCompact.map((line) => (
                <span class="cw-headline__line cw-headline__line--compact" aria-hidden="true">{line}</span>
              ))
            }
          </h1>
          <p class="cw-lede">{c.hero.lede}</p>
          <div class="cw-actions">
            <Btn primary href={c.hero.primaryHref}>{c.hero.primaryCta}</Btn>
            <Btn href={c.hero.secondaryHref}>{c.hero.secondaryCta}</Btn>
          </div>
          <p class="cw-meta">{c.hero.meta}</p>
        </div>
        <MediaClip
          src={clips.hero.src}
          poster={clips.hero.poster}
          alt={c.hero.mediaAlt}
          caption={c.hero.caption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-section" id="gather" data-screen-label="Gather from vault structure">
      <div class="cw-wrap cw-feature-grid">
        <div class="cw-feature-copy">
          <p class="cw-kicker">{c.gather.kicker}</p>
          <h2>{c.gather.title}</h2>
          <p class="cw-section-body">{c.gather.body}</p>
          <ul class="cw-proof-labels" aria-label={locale === 'zh' ? '浏览能力' : 'Browsing capabilities'}>
            {c.gather.labels.map((label) => <li>{label}</li>)}
          </ul>
        </div>
        <MediaClip
          src={clips.gather.src}
          poster={clips.gather.poster}
          alt={c.gather.mediaAlt}
          caption={c.gather.caption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-section" id="card-images" data-screen-label="Card images">
      <div class="cw-wrap cw-feature-grid cw-feature-grid--visual-first">
        <div class="cw-feature-copy">
          <p class="cw-kicker">{c.images.kicker}</p>
          <h2>{c.images.title}</h2>
          <p class="cw-section-body">{c.images.body}</p>
          <ul class="cw-proof-labels" aria-label={locale === 'zh' ? '卡片图片选项' : 'Card image options'}>
            {c.images.labels.map((label) => <li>{label}</li>)}
          </ul>
        </div>
        <MediaClip
          src={clips.images.src}
          poster={clips.images.poster}
          alt={c.images.mediaAlt}
          caption={c.images.caption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-section" id="linked-notes" data-screen-label="Linked-note context">
      <div class="cw-wrap cw-feature-grid">
        <div class="cw-feature-copy">
          <p class="cw-kicker">{c.links.kicker}</p>
          <h2>{c.links.title}</h2>
          <p class="cw-section-body">{c.links.body}</p>
          <ul class="cw-proof-labels" aria-label={locale === 'zh' ? '双链能力' : 'Linked-note capabilities'}>
            {c.links.labels.map((label) => <li>{label}</li>)}
          </ul>
        </div>
        <MediaClip
          src={clips.links.src}
          poster={clips.links.poster}
          alt={c.links.mediaAlt}
          caption={c.links.caption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-section" id="search" data-screen-label="Local full-text search">
      <div class="cw-wrap cw-feature-grid cw-feature-grid--visual-first">
        <div class="cw-feature-copy">
          <p class="cw-kicker">{c.search.kicker}</p>
          <h2>{c.search.title}</h2>
          <p class="cw-section-body">{c.search.body}</p>
          <ul class="cw-proof-labels" aria-label={locale === 'zh' ? '搜索能力' : 'Search capabilities'}>
            {c.search.labels.map((label) => <li>{label}</li>)}
          </ul>
        </div>
        <MediaClip
          src={clips.search.src}
          poster={clips.search.poster}
          alt={c.search.mediaAlt}
          caption={c.search.caption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-section" id="drag" data-screen-label="Reframe in writing">
      <div class="cw-wrap cw-feature-grid">
        <div class="cw-feature-copy">
          <p class="cw-kicker">{c.drag.kicker}</p>
          <h2>{c.drag.title}</h2>
          <p class="cw-section-body">{c.drag.body}</p>
          <ul class="cw-action-list" aria-label={locale === 'zh' ? 'Markdown 拖入操作' : 'Markdown drop actions'}>
            {c.drag.actions.map((action, index) => <li><span>0{index + 1}</span>{action}</li>)}
          </ul>
        </div>
        <MediaClip
          src={clips.drag.src}
          poster={clips.drag.poster}
          alt={c.drag.mediaAlt}
          caption={c.drag.mediaCaption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-section" id="card-boxes" data-screen-label="Organize views">
      <div class="cw-wrap cw-feature-grid cw-feature-grid--visual-first">
        <div class="cw-feature-copy">
          <p class="cw-kicker">{c.boxes.kicker}</p>
          <h2>{c.boxes.title}</h2>
          <p class="cw-section-body">{c.boxes.body}</p>
          <p class="cw-support">{c.boxes.support}</p>
        </div>
        <MediaClip
          src={clips.boxes.src}
          poster={clips.boxes.poster}
          alt={c.boxes.mediaAlt}
          caption={c.boxes.caption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-section" id="bulk" data-screen-label="Bulk organization">
      <div class="cw-wrap cw-feature-grid">
        <div class="cw-feature-copy">
          <p class="cw-kicker">{c.bulk.kicker}</p>
          <h2>{c.bulk.title}</h2>
          <p class="cw-section-body">{c.bulk.body}</p>
          <ul class="cw-proof-labels" aria-label={locale === 'zh' ? '批量选择方式' : 'Bulk selection methods'}>
            {c.bulk.selectionModes.map((label) => <li>{label}</li>)}
          </ul>
          <ul class="cw-bulk-actions" aria-label={locale === 'zh' ? '批量操作' : 'Bulk actions'}>
            {c.bulk.actions.map((action) => <li>{action}</li>)}
          </ul>
        </div>
        <MediaClip
          src={clips.bulk.src}
          poster={clips.bulk.poster}
          alt={c.bulk.mediaAlt}
          caption={c.bulk.caption}
          playLabel={c.clipPlayLabel}
          pauseLabel={c.clipPauseLabel}
        />
      </div>
    </section>

    <SectionRule />

    <section class="cw-details" id="daily-details" data-screen-label="Daily experience details">
      <div class="cw-wrap">
        <header class="cw-details__head">
          <div>
            <p class="cw-kicker">{c.details.kicker}</p>
            <h2>{c.details.title}</h2>
          </div>
          <p>{c.details.body}</p>
        </header>
        <ol class="cw-detail-grid">
          {c.details.items.map((item, index) => (
            <li>
              <span>0{index + 1}</span>
              <div><h3>{item.title}</h3><p>{item.body}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <SectionRule />

    <section class="cw-final" id="install" data-screen-label="Install">
      <div class="cw-wrap cw-final__inner">
        <div>
          <h2>{c.cta.title}</h2>
          <p>{c.cta.body}</p>
        </div>
        <div class="cw-actions">
          <Btn primary href={c.cta.primaryHref}>{c.cta.primaryCta}</Btn>
          <Btn href={c.cta.secondaryHref}>{c.cta.secondaryCta}</Btn>
        </div>
      </div>
    </section>
  </div>

  <SectionRule />

  <footer class="cw-footer">
    <div class="cw-wrap cw-footer__inner">
      <div class="cw-footer__brand">
        <a class="cw-brand" href="#top">
          <BrandMark />
          <span class="cw-brand__name">Card Workspace</span>
        </a>
        <p>{c.footer.tagline}</p>
      </div>
      <nav aria-label={locale === 'zh' ? '页脚导航' : 'Footer'}>
        {c.footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <p class="cw-footer__legal">{c.footer.legal}</p>
    </div>
  </footer>
</div>

<script>
  // The client router replaces the body on navigation, so bind on every page
  // load rather than once at module evaluation.
  document.addEventListener('astro:page-load', () => {
    const skipLink = document.querySelector<HTMLAnchorElement>('.cw-skip');
    const mainTarget = document.querySelector<HTMLElement>('#cw-main');

    skipLink?.addEventListener('click', () => {
      requestAnimationFrame(() => mainTarget?.focus({ preventScroll: true }));
    });
  });
</script>
