---
import '../../styles/landing.css';
import { getLanding, type Locale } from '../../content/landing';
import BrandMark from './BrandMark.astro';
import Label from './Label.astro';
import VersionBadge from './VersionBadge.astro';
import Btn from './Btn.astro';
import SectionCard from './SectionCard.astro';
import Tiles from './Tiles.astro';
import RulesPanel from './RulesPanel.astro';
import BoxViz from './BoxViz.astro';
import Shot from './Shot.astro';
import ImageSlot from './ImageSlot.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getLanding(locale);
const s = c.sections;
---

<div class="cw-page not-content">
  <header class="cw-header">
    <div class="cw-wrap cw-header__inner">
      <a class="cw-brand" href="#top">
        <BrandMark />
        <span class="cw-brand__name">Card Workspace</span>
      </a>
      <VersionBadge version={c.version} title={c.versionTitle} />
      <nav class="cw-nav">
        {c.nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </div>
  </header>

  <section class="cw-hero" id="top" data-screen-label="Hero">
    <div class="cw-wrap">
      <div class="cw-hero__copy cw-deal" style="--cw-deal-rot: 0deg">
        <Label accent>{c.hero.eyebrow}</Label>
        <h1 class="cw-display">
          {
            c.hero.headline.map((line, i) => (
              <span class="cw-display__line">
                {i === c.hero.headlineEmphasis ? <em>{line}</em> : line}
              </span>
            ))
          }
        </h1>
        <p class="cw-lede">{c.hero.tagline}</p>
        <div class="cw-actions">
          <Btn primary href={c.hero.primaryHref}>{c.hero.primaryCta}</Btn>
          <Btn href={c.hero.secondaryHref}>{c.hero.secondaryCta}</Btn>
        </div>
      </div>
      <Shot caption={c.hero.shotCaption} />
    </div>
  </section>

  <div class="cw-wrap cw-stream">
    <SectionCard id="why" index={s.why.index} kicker={s.why.kicker} title={s.why.title} order={0}>
      <div class="cw-sec__text">
        <p class="cw-body">{s.why.body}</p>
        <Tiles items={s.why.points} />
      </div>
      <div class="cw-sec__media">
        <ImageSlot label="cards" desc={s.why.slot} />
      </div>
    </SectionCard>

    <SectionCard id="nav" index={s.nav.index} kicker={s.nav.kicker} title={s.nav.title} order={1}>
      <div class="cw-sec__text">
        <p class="cw-body">{s.nav.body}</p>
        <Tiles items={s.nav.points} />
      </div>
      <div class="cw-sec__media">
        <ImageSlot label="navigation" desc={s.nav.slot} />
      </div>
    </SectionCard>

    <SectionCard id="boxes" index={s.boxes.index} kicker={s.boxes.kicker} title={s.boxes.title} order={2}>
      <div class="cw-sec__text">
        <p class="cw-body">{s.boxes.body}</p>
        <RulesPanel rules={s.boxes.rules} />
        <p class="cw-body cw-body--aside">{s.boxes.aside}</p>
      </div>
      <div class="cw-sec__media">
        <BoxViz rules={s.boxes.rules} viz={s.boxes.boxViz} />
        <p class="cw-caption cw-caption--start">{s.boxes.boxViz.caption}</p>
      </div>
    </SectionCard>

    <SectionCard id="flow" index={s.flow.index} kicker={s.flow.kicker} title={s.flow.title} order={3}>
      <div class="cw-sec__text">
        <p class="cw-body">{s.flow.body}</p>
        <Tiles items={s.flow.points} />
        <p class="cw-body cw-body--aside">{s.flow.aside}</p>
      </div>
      <div class="cw-sec__media">
        <ImageSlot label="drag to insert" desc={s.flow.slot} />
      </div>
    </SectionCard>

    <SectionCard id="scale" index={s.scale.index} kicker={s.scale.kicker} title={s.scale.title} order={4}>
      <div class="cw-sec__text">
        <p class="cw-body">{s.scale.body}</p>
        <Tiles items={s.scale.points} />
      </div>
      <div class="cw-sec__media">
        <div class="cw-subcard">
          <Label accent as="span">{`${s.privacy.index} · ${s.privacy.kicker}`}</Label>
          <h3 class="cw-h3">{s.privacy.title}</h3>
          <p class="cw-body">{s.privacy.body}</p>
          <span class="cw-badge">{s.privacy.badge}</span>
        </div>
      </div>
    </SectionCard>

    <SectionCard
      id="install"
      index={s.install.index}
      kicker={s.install.kicker}
      title={s.install.title}
      order={5}
    >
      <div class="cw-sec__text">
        <p class="cw-body">{s.install.body}</p>
        <div class="cw-actions">
          <Btn primary href={s.install.primaryHref}>{s.install.primaryCta}</Btn>
          <Btn href={s.install.secondaryHref}>{s.install.secondaryCta}</Btn>
        </div>
        <span class="cw-todo">{s.install.note}</span>
      </div>
      <div class="cw-sec__media">
        <ol class="cw-steps">
          {s.install.steps.map((st) => (
            <li>
              <span>{st}</span>
            </li>
          ))}
        </ol>
      </div>
    </SectionCard>
  </div>

  <footer class="cw-footer">
    <div class="cw-wrap">
      <div class="cw-footer__grid">
        <div class="cw-footer__col">
          <a class="cw-brand cw-footer__brand" href="#top">
            <BrandMark />
            <span class="cw-brand__name">Card Workspace</span>
          </a>
          <p class="cw-body cw-footer__tagline">{c.footer.tagline}</p>
        </div>
        {
          c.footer.columns.map((col) => (
            <div class="cw-footer__col">
              <h4 class="cw-label">{col.title}</h4>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="cw-footer__legal">
        <Label as="span">{c.footer.legal}</Label>
        <Label as="span">{c.version}</Label>
      </div>
    </div>
  </footer>
</div>

<script>
  function markShown(nodes: Element[]) {
    for (const node of nodes) {
      node.setAttribute('data-shown', 'true');
    }
  }

  function initCwDealIn() {
    const root = document.querySelector('.cw-page');
    if (!root) return;

    const nodes = Array.from(root.querySelectorAll('.cw-deal'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      markShown(nodes);
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-shown', 'true');
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
    );

    for (const node of nodes) {
      node.removeAttribute('data-shown');
      if (node.getBoundingClientRect().top < window.innerHeight * 0.94) {
        node.setAttribute('data-shown', 'true');
        continue;
      }
      io.observe(node);
    }
  }

  initCwDealIn();
</script>
