---
import type { BoxRule, RuleOp } from '../../content/landing';

interface Props {
  rules: BoxRule[];
}

const { rules } = Astro.props;
const opText: Record<RuleOp, string> = { scope: 'scope', or: 'or', minus: 'except' };
---

<div class="cw-rules">
  {
    rules.map((r) => (
      <div class="cw-rules__row" data-op={r.op}>
        <span class="cw-rules__op">{opText[r.op]}</span>
        <span class="cw-rules__value">{r.value}</span>
      </div>
    ))
  }
</div>
