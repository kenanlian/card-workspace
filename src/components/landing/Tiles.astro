---
import type { TileItem } from '../../content/landing';

interface Props {
  items: TileItem[];
}

const { items } = Astro.props;
---

<div class="cw-tiles">
  {
    items.map((it) => (
      <article class="cw-tile">
        <span class="cw-tile__term">{it.term}</span>
        <span class="cw-tile__desc">{it.desc}</span>
      </article>
    ))
  }
</div>
