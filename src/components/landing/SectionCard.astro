---
interface Props {
  id: string;
  index: string;
  kicker: string;
  title: string;
  order?: number;
}

const { id, index, kicker, title, order = 0 } = Astro.props;
const rot = order % 2 === 0 ? '-1.1deg' : '0.9deg';
---

<section
  class="cw-card cw-deal"
  id={id}
  style={`--cw-deal-rot: ${rot}`}
  data-screen-label={`${index} ${kicker}`}
>
  <span class="cw-card__tab">{index}</span>
  <div class="cw-card__grid">
    <p class="cw-label cw-sec__kicker">{kicker}</p>
    <h2 class="cw-h2 cw-sec__title">{title}</h2>
    <slot />
  </div>
</section>
