---
interface Props {
  label: string;
  title: string;
  brief: string;
  kind?: 'screenshot' | 'clip';
  featured?: boolean;
}

const { label, title, brief, kind = 'screenshot', featured = false } = Astro.props;
---

<figure class:list={['cw-media', featured && 'cw-media--featured', `cw-media--${kind}`]}>
  <div class="cw-media__frame" role="img" aria-label={`${label}. ${title}. ${brief}`}>
    <div class="cw-media__chrome" aria-hidden="true">
      <span></span><span></span><span></span>
      <i></i>
    </div>
    <div class="cw-media__map" aria-hidden="true">
      <div class="cw-media__rail">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="cw-media__stream">
        <span></span><span></span><span></span>
      </div>
      <div class="cw-media__editor">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
    <div class="cw-media__brief">
      <span class="cw-media__label">{label}</span>
      <strong>{title}</strong>
      <span>{brief}</span>
    </div>
    {kind === 'clip' && <div class="cw-media__timeline" aria-hidden="true"><span></span></div>}
  </div>
</figure>
