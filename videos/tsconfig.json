{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["svelte", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "obsidian": ["plugin-snapshots/1.4.2/node_modules/obsidian"],
      "@plugin/*": ["plugin-snapshots/1.4.2/src/*"]
    }
  },
  "include": ["src/**/*.ts", "plugin-snapshots/1.4.2/src/electron.d.ts"]
}
